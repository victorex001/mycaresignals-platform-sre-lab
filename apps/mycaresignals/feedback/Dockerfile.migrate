FROM alpine:3.20

ARG TARGETARCH

RUN apk add --no-cache ca-certificates curl \
  && curl -L https://github.com/golang-migrate/migrate/releases/download/v4.17.0/migrate.linux-${TARGETARCH}.tar.gz \
  | tar -xz \
  && mv migrate /usr/local/bin/migrate

COPY internal/migrations /migrations

ENTRYPOINT ["/bin/sh","-lc"]
