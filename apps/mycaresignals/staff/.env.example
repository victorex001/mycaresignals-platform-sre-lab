POSTGRES_USER=replace-with-local-postgres-user
POSTGRES_PASSWORD=replace-with-local-postgres-password
POSTGRES_DB=replace-with-local-database-name
POSTGRES_DSN=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
OPENAI_API_KEY=replace-with-openai-api-key
PORT=8081
APP_ENV=development
AUTH_MODE=development
ENABLE_DEV_AUTH=true
DEV_JWT_ISSUER=https://example.invalid/mycaresignals-dev
DEV_JWT_AUDIENCE=mycaresignals-dev
DEV_JWT_HMAC_SECRET=replace-with-at-least-32-random-characters
ALLOW_DEMO_SEED=false
DEMO_SEED_KEY=replace-with-random-demo-seed-key

# Production staff authentication uses Cognito hosted login with authorization
# code + PKCE. Do not commit real secrets; these are non-secret identifiers/URLs.
# APP_ENV=production
# AUTH_MODE=cognito
# AWS_REGION=eu-west-2
# COGNITO_USER_POOL_ID=eu-west-2_example
# COGNITO_CLIENT_ID=example-public-client-id
# COGNITO_ISSUER=https://cognito-idp.eu-west-2.amazonaws.com/eu-west-2_example
