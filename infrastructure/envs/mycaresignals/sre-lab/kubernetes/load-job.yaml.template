apiVersion: batch/v1
kind: Job
metadata:
  name: __JOB_NAME__
  namespace: mycaresignals-load
  labels:
    app.kubernetes.io/name: mycaresignals-load
    sre.mycaresignals/profile: __PROFILE__
spec:
  completions: __SHARDS__
  parallelism: __SHARDS__
  completionMode: Indexed
  backoffLimitPerIndex: 0
  maxFailedIndexes: 0
  activeDeadlineSeconds: __ACTIVE_DEADLINE_SECONDS__
  ttlSecondsAfterFinished: 86400
  template:
    metadata:
      labels:
        app.kubernetes.io/name: mycaresignals-load
        sre.mycaresignals/profile: __PROFILE__
    spec:
      restartPolicy: Never
      automountServiceAccountToken: false
      terminationGracePeriodSeconds: 60
      nodeSelector:
        workload: load
      tolerations:
        - key: dedicated
          operator: Equal
          value: load
          effect: NoSchedule
      containers:
        - name: k6
          image: __LOADGEN_IMAGE__
          imagePullPolicy: IfNotPresent
          command: ["k6"]
          args: ["run", "/scripts/scenario.js"]
          env:
            - name: BASE_URL
              value: http://teapi.mycaresignals-sre-lab.svc.cluster.local:8081
            - name: PROFILE
              value: __PROFILE__
            - name: SHARD_COUNT
              value: "__SHARDS__"
            - name: SHARD_INDEX
              valueFrom:
                fieldRef:
                  fieldPath: metadata.annotations['batch.kubernetes.io/job-completion-index']
            - name: USER_POPULATION
              value: "1000000"
            - name: HOME_COUNT
              value: "10000"
            - name: DEV_JWT_ISSUER
              value: https://sre-lab.invalid/mycaresignals
            - name: DEV_JWT_AUDIENCE
              value: mycaresignals-sre-lab
            - name: DEV_JWT_HMAC_SECRET
              valueFrom:
                secretKeyRef:
                  name: load-runtime
                  key: DEV_JWT_HMAC_SECRET
          resources:
            requests:
              cpu: "2"
              memory: 2Gi
            limits:
              cpu: "4"
              memory: 4Gi
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
          volumeMounts:
            - name: tmp
              mountPath: /tmp
      volumes:
        - name: tmp
          emptyDir: {}
