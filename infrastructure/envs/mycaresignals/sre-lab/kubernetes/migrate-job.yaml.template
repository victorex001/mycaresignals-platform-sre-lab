apiVersion: batch/v1
kind: Job
metadata:
  name: teapi-migrate
  namespace: mycaresignals-sre-lab
  labels:
    app.kubernetes.io/name: teapi-migrate
spec:
  backoffLimit: 1
  activeDeadlineSeconds: 900
  ttlSecondsAfterFinished: 86400
  template:
    metadata:
      labels:
        app.kubernetes.io/name: teapi-migrate
    spec:
      restartPolicy: Never
      automountServiceAccountToken: false
      nodeSelector:
        workload: system
      containers:
        - name: migrate
          image: __MIGRATOR_IMAGE__
          imagePullPolicy: IfNotPresent
          args:
            - migrate -path /migrations -database "$POSTGRES_DSN" up
          envFrom:
            - secretRef:
                name: teapi-runtime
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
            limits:
              cpu: 500m
              memory: 256Mi
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
