apiVersion: batch/v1
kind: Job
metadata:
  name: synthetic-seed
  namespace: mycaresignals-sre-lab
  labels:
    app.kubernetes.io/name: synthetic-seed
spec:
  backoffLimit: 0
  activeDeadlineSeconds: 10800
  ttlSecondsAfterFinished: 86400
  template:
    metadata:
      labels:
        app.kubernetes.io/name: synthetic-seed
    spec:
      restartPolicy: Never
      automountServiceAccountToken: false
      nodeSelector:
        workload: system
      containers:
        - name: seed
          image: __SEED_IMAGE__
          imagePullPolicy: IfNotPresent
          command: ["/bin/sh", "-ec"]
          args:
            - >-
              psql
              --set=confirmation=SRE_LAB_SYNTHETIC_ONLY
              --set=user_count=__USER_COUNT__
              --set=home_count=__HOME_COUNT__
              --set=active_children_per_home=__ACTIVE_CHILDREN_PER_HOME__
              --set=historical_children_per_home=__HISTORICAL_CHILDREN_PER_HOME__
              --set=audit_event_count=__AUDIT_EVENT_COUNT__
              --file=/seed/seed.sql
              && psql --file=/seed/verify.sql
          env:
            - name: PGHOST
              valueFrom:
                secretKeyRef:
                  name: teapi-database
                  key: PGHOST
            - name: PGPORT
              valueFrom:
                secretKeyRef:
                  name: teapi-database
                  key: PGPORT
            - name: PGDATABASE
              valueFrom:
                secretKeyRef:
                  name: teapi-database
                  key: PGDATABASE
            - name: PGUSER
              valueFrom:
                secretKeyRef:
                  name: teapi-database
                  key: PGUSER
            - name: PGPASSWORD
              valueFrom:
                secretKeyRef:
                  name: teapi-database
                  key: PGPASSWORD
            - name: PGSSLMODE
              value: require
          resources:
            requests:
              cpu: "1"
              memory: 1Gi
            limits:
              cpu: "2"
              memory: 2Gi
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
