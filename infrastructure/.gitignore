# Terraform local working dir
**/.terraform/
**/.terraform.lock.hcl.backup

# Terraform state / plans
**/*.tfstate
**/*.tfstate.*
**/*.tfplan
**/*.plan
**/tfplan

# Sensitive tfvars
**/*.tfvars
**/*.tfvars.json
!**/*.tfvars.example

# Local environment/secrets
.env
.env.*
*.env
*.local
*.local.*
config.toml
**/backend.hcl

# Crash logs
crash.log
crash.*.log
